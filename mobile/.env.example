# Mobile env. Copy to `.env` and edit before running.
# Anything starting with EXPO_PUBLIC_ is inlined at build time and is safe for the client.
#
# Use your PC's LAN IP (NOT localhost) so a physical Android device on Expo Go
# can reach the backend.
#   On Windows: run `ipconfig` and look for IPv4 Address of your Wi-Fi adapter.
#   Example: EXPO_PUBLIC_API_URL=http://192.168.1.42:5000

EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
